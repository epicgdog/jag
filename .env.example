# Copy to .env.local and supply your own values. Never commit .env.local.
NOTION_API_KEY=your_notion_integration_token
NOTION_DATABASE_ID=your_notion_database_id_or_url
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=your_backend_secret_key
SUPABASE_ACCESS_TOKEN=your_personal_access_token
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=embeddinggemma-2
# Optional: override the default ~/Documents/vaults/main/journal root.
# OBSIDIAN_JOURNAL_DIR=/absolute/path/to/journal
# LM_STUDIO_BASE_URL=http://localhost:1234/v1
